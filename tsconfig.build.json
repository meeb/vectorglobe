{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/types",
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests", "scripts"]
}
